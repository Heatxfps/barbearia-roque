{
  "name": "barbearia-roque-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Protótipo do aplicativo da Barbearia Roque (Nova Venécia/ES)",
  "scripts": {
    "dev": "vite --host",
    "dev:offline": "vite --host --mode offline",
    "build": "tsc -b && vite build",
    "build:offline": "tsc -b && vite build --mode offline",
    "preview": "vite preview --host",
    "servidor": "npm --prefix server run dev",
    "servidor:demo": "npm --prefix server run seed:demo -- --limpar",
    "test": "npm --prefix server test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
