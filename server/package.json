{
  "name": "barbearia-roque-servidor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "API da Barbearia Roque: agenda, clientes, fidelidade, lembretes por WhatsApp e painel do dono",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "seed:demo": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/seed-demo.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "configurar": "node --disable-warning=ExperimentalWarning src/configurar.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
