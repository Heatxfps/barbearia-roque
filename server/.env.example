# ---------- obrigatório em produção ----------
# gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SEGREDO=troque-por-um-segredo-longo
ADMIN_EMAIL=dono@barbeariaroque.com.br
ADMIN_SENHA=troque-esta-senha
ADMIN_NOME=Luciano Roque

# ---------- WhatsApp ----------
# demo      = não envia; as mensagens aparecem no painel (bom para apresentação)
# evolution = Evolution API (grátis, roda na VPS, conecta o WhatsApp da barbearia por QR code)
# zapi      = Z-API (pago, ~R$ 100/mês, mais estável)
WHATSAPP_MODO=demo
EVOLUTION_URL=http://evolution:8080
EVOLUTION_INSTANCIA=roque
EVOLUTION_CHAVE=
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# AVISAR_BARBEARIA=1          manda para o WhatsApp da barbearia cada horário marcado/cancelado pelo app (0 = desliga)

# ---------- regras (opcional) ----------
# PASSO_MIN=30                 intervalo entre horários na agenda
# ANTECEDENCIA_AGENDAR_MIN=30  quanto tempo antes dá para marcar
# ANTECEDENCIA_CANCELAR_MIN=120  cliente cancela pelo app até 2h antes
# DIAS_AGENDA=21               quantos dias à frente aparecem
# FIDELIDADE_META=10           a cada 10 atendimentos, 1 grátis
# DIAS_RETORNO=20              "volte a cortar" depois de 20 dias

# ---------- infraestrutura (normalmente não mexer) ----------
# PORTA=3333
# BANCO=dados/roque.db
# ORIGEM_APP=*                 domínios que podem chamar a API (CORS)
