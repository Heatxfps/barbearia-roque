{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "roque",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "roque-servidor",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 3333
    },
    {
      "name": "roque-offline",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:offline",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}